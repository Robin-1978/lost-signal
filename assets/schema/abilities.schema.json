{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "abilities",
  "type": "object",
  "required": [
    "schema_version",
    "abilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ability\\.[a-z_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
