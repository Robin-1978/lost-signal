{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-cues.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cues",
    "events",
    "decision_transition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codes",
          "cue",
          "cooldown_s"
        ],
        "properties": {
          "codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "cue": {
            "$ref": "#/$defs/id"
          },
          "cooldown_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          }
        }
      }
    },
    "decision_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_code",
        "enter_cue",
        "exit_cue",
        "exit_stable_s"
      ],
      "properties": {
        "action_code": {
          "$ref": "#/$defs/id"
        },
        "enter_cue": {
          "$ref": "#/$defs/id"
        },
        "exit_cue": {
          "$ref": "#/$defs/id"
        },
        "exit_stable_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    }
  }
}
