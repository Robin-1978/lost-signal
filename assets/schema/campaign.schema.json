{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "id",
    "title",
    "companion",
    "starting_level",
    "levels",
    "playgrounds",
    "collections",
    "starting_inventory",
    "starting_policies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_code",
        "display_name",
        "robot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit_code": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "robot": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "starting_level": {
      "$ref": "#/$defs/id"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "playgrounds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "starting_inventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "starting_policies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eyebrow",
        "title",
        "subtitle",
        "accent",
        "levels"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    }
  }
}
