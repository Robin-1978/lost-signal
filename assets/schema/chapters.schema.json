{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "chapters.schema.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "chapters"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "chapters": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "blurb"
    ],
    "properties": {
     "id": {
      "type": "integer",
      "minimum": 1
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "blurb": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
