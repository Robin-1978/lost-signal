{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slot",
    "model_profile",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "slot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "basis",
        "source_refs"
      ],
      "properties": {
        "fidelity": {
          "enum": [
            "ideal",
            "typical",
            "identified"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "cost",
          "behavior",
          "visual"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "integer",
            "minimum": 0
          },
          "behavior": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primitive_2d",
              "size_m",
              "color",
              "model_3d"
            ],
            "properties": {
              "primitive_2d": {
                "enum": [
                  "box",
                  "wheel",
                  "disc"
                ]
              },
              "size_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
              },
              "model_3d": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./-]+\\.glb$|^[a-zA-Z0-9_./-]+\\.gltf$"
              }
            }
          }
        }
      }
    }
  }
}
