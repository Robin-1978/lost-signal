{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContractBoard",
  "type": "object",
  "required": [
    "schema_version",
    "week",
    "seed",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "cargo",
          "axis",
          "rep",
          "mass_kg",
          "cog_height_m",
          "fragility",
          "blurb"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "cargo": {
            "enum": [
              "grain",
              "mail",
              "parts",
              "medkit",
              "water"
            ]
          },
          "axis": {
            "enum": [
              "fast",
              "efficient",
              "safe"
            ]
          },
          "rep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cog_height_m": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2.0
          },
          "fragility": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "blurb": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
