{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "order",
    "title",
    "map",
    "control_mode",
    "localization_mode",
    "prerequisites",
    "seed",
    "objective",
    "loadout_rules",
    "teaching",
    "score",
    "rewards",
    "chapter",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "$ref": "#/$defs/id"
    },
    "control_mode": {
      "enum": [
        "manual_calibration",
        "autonomous"
      ]
    },
    "localization_mode": {
      "enum": [
        "odometry",
        "fused"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass_kg",
        "cog_height_m"
      ],
      "properties": {
        "mass_kg": {
          "type": "number",
          "minimum": 0
        },
        "cog_height_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "spawn",
        "goal",
        "goal_label",
        "goal_visual",
        "time_limit_s",
        "max_collisions",
        "arrive_tolerance_m"
      ],
      "properties": {
        "type": {
          "enum": [
            "reach",
            "observe_and_stop",
            "deliver_via"
          ]
        },
        "spawn": {
          "$ref": "#/$defs/id"
        },
        "via": {
          "$ref": "#/$defs/id"
        },
        "via_label": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "$ref": "#/$defs/id"
        },
        "goal_label": {
          "type": "string",
          "minLength": 1
        },
        "goal_visual": {
          "enum": [
            "exit",
            "stop_zone",
            "calibration_pad",
            "supply_station",
            "signal_tower"
          ]
        },
        "time_limit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "max_collisions": {
          "type": "integer",
          "minimum": 0
        },
        "arrive_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "via_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "marker",
              "action"
            ],
            "properties": {
              "marker": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "pickup",
                  "complete",
                  "summon",
                  "recharge",
                  "inspect"
                ]
              },
              "radius_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "summon_actor": {
                "$ref": "#/$defs/id"
              },
              "recharge_wh": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "dwell_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "max_arrival_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional speed limit for completing the final goal zone."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "deliver_via"
              }
            }
          },
          "then": {
            "required": [
              "via",
              "via_label",
              "via_radius_m"
            ]
          }
        }
      ]
    },
    "loadout_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "required_slots"
      ],
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": 1
        },
        "required_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tires",
              "sensor",
              "computer",
              "motor",
              "imu"
            ]
          }
        }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "prediction_prompt",
        "knowledge_card"
      ],
      "properties": {
        "concept": {
          "$ref": "#/$defs/id"
        },
        "prediction_prompt": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_card": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_min_clearance_m",
        "fast_time_s",
        "efficient_energy_wh"
      ],
      "properties": {
        "safe_min_clearance_m": {
          "type": "number",
          "minimum": 0
        },
        "safe_clearance_scope": {
          "type": "string",
          "enum": [
            "all",
            "static",
            "dynamic"
          ]
        },
        "max_localization_error_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fast_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "efficient_energy_wh": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rewards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "mainline",
        "contract",
        "experiment"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    }
  }
}
