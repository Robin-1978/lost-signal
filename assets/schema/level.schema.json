{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "order",
    "title",
    "map",
    "control_mode",
    "localization_mode",
    "prerequisites",
    "seed",
    "objective",
    "loadout_rules",
    "teaching",
    "score",
    "rewards",
    "chapter",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "$ref": "#/$defs/id"
    },
    "control_mode": {
      "enum": [
        "manual_calibration",
        "operator_drive",
        "autonomous"
      ]
    },
    "localization_mode": {
      "enum": [
        "odometry",
        "known_map"
      ]
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localization_margin_m"
      ],
      "properties": {
        "localization_margin_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass_kg",
        "cog_height_m"
      ],
      "properties": {
        "mass_kg": {
          "type": "number",
          "minimum": 0
        },
        "cog_height_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "spawn",
        "goal",
        "goal_label",
        "goal_visual",
        "time_limit_s",
        "max_collisions",
        "arrive_tolerance_m"
      ],
      "properties": {
        "type": {
          "enum": [
            "reach",
            "observe_and_stop",
            "deliver_via",
            "collect_and_return"
          ]
        },
        "spawn": {
          "$ref": "#/$defs/id"
        },
        "via": {
          "$ref": "#/$defs/id"
        },
        "via_label": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "$ref": "#/$defs/id"
        },
        "goal_label": {
          "type": "string",
          "minLength": 1
        },
        "goal_visual": {
          "$ref": "#/$defs/id"
        },
        "time_limit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "max_collisions": {
          "type": "integer",
          "minimum": 0
        },
        "arrive_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "via_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "marker",
              "action"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "marker": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "pickup",
                  "collect",
                  "complete",
                  "summon",
                  "recharge",
                  "inspect"
                ]
              },
              "radius_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "summon_actor": {
                "$ref": "#/$defs/id"
              },
              "recharge_wh": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "dwell_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "item": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "mass_kg",
                  "cog_height_m",
                  "value",
                  "fragility"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mass_kg": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cog_height_m": {
                    "type": "number",
                    "minimum": 0
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "fragility": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "visual": {
                "$ref": "#/$defs/id"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "collect"
                    }
                  }
                },
                "then": {
                  "required": [
                    "id",
                    "item"
                  ]
                }
              }
            ]
          }
        },
        "goal_order": {
          "enum": [
            "authored",
            "autonomous",
            "player"
          ]
        },
        "task_policy": {
          "$ref": "#/$defs/id"
        },
        "return_reserve_s": {
          "type": "number",
          "minimum": 0
        },
        "max_arrival_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional speed limit for completing the final goal zone."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "deliver_via"
              }
            }
          },
          "then": {
            "required": [
              "via",
              "via_label",
              "via_radius_m"
            ]
          }
        }
      ]
    },
    "loadout_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "required_slots"
      ],
      "properties": {
        "access": {
          "enum": [
            "campaign",
            "open"
          ]
        },
        "budget": {
          "type": "integer",
          "minimum": 1
        },
        "required_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tires",
              "tracks",
              "sensor",
              "computer",
              "motor",
              "imu"
            ]
          }
        }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "prediction_prompt",
        "knowledge_card"
      ],
      "properties": {
        "concept": {
          "$ref": "#/$defs/id"
        },
        "prediction_prompt": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_card": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_min_clearance_m",
        "fast_time_s",
        "efficient_energy_wh"
      ],
      "properties": {
        "safe_min_clearance_m": {
          "type": "number",
          "minimum": 0
        },
        "safe_clearance_scope": {
          "type": "string",
          "enum": [
            "all",
            "static",
            "dynamic"
          ]
        },
        "max_localization_error_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fast_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "efficient_energy_wh": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rewards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "mainline",
        "contract",
        "experiment",
        "playground"
      ]
    },
    "construction": {
      "$ref": "#/$defs/construction"
    },
    "manipulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waypoints"
      ],
      "properties": {
        "success_position_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25
        },
        "waypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_s",
              "target_m",
              "tool_pitch_rad"
            ],
            "properties": {
              "time_s": {
                "type": "number",
                "minimum": 0
              },
              "target_m": {
                "$ref": "#/$defs/vec3"
              },
              "tool_pitch_rad": {
                "type": "number",
                "minimum": -3.141593,
                "maximum": 3.141593
              }
            }
          }
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "maneuvers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "spawn",
          "goal",
          "control",
          "metrics"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "spawn": {
            "$ref": "#/$defs/id"
          },
          "goal": {
            "$ref": "#/$defs/id"
          },
          "control": {
            "enum": [
              "manual",
              "autonomous"
            ]
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "stop_distance",
                "stop_time",
                "turn_radius",
                "steering_tracking",
                "grade",
                "cross_slope",
                "rollover_risk",
                "rough_contact",
                "slip",
                "lidar_returns"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snap_tolerance_m",
        "inventory",
        "sockets",
        "default_plan",
        "plans"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "snap_tolerance_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "inventory": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sockets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "position_m"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "$ref": "#/$defs/id"
              },
              "position_m": {
                "$ref": "#/$defs/vec3"
              }
            }
          }
        },
        "default_plan": {
          "$ref": "#/$defs/id"
        },
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "placements"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "placements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instance_id",
                    "piece_id",
                    "start_socket",
                    "end_socket"
                  ],
                  "properties": {
                    "instance_id": {
                      "$ref": "#/$defs/id"
                    },
                    "piece_id": {
                      "$ref": "#/$defs/id"
                    },
                    "start_socket": {
                      "$ref": "#/$defs/id"
                    },
                    "end_socket": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpolation",
        "keyframes"
      ],
      "properties": {
        "interpolation": {
          "const": "linear"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/environment_keyframe"
          }
        }
      }
    },
    "environment_keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "time_s",
        "wetness",
        "visibility",
        "daylight",
        "material_grip"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "wetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visibility": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "daylight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_grip": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1.5
          }
        }
      }
    }
  }
}
