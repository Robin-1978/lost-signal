{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "locales",
  "type": "object",
  "required": [
    "schema_version",
    "default_locale",
    "source_locale",
    "supported_locales"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_locale": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "source_locale": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
