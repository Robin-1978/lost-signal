{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scene_3d",
    "size_m",
    "grid_resolution_m",
    "obstacles",
    "surfaces",
    "markers",
    "actors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "scene_3d": {
      "$ref": "#/$defs/id"
    },
    "size_m": {
      "$ref": "#/$defs/positive_vec2"
    },
    "grid_resolution_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "obstacles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "markers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pose"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "positive_vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false
    },
    "pose": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "active": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "min",
        "max"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "box"
        },
        "min": {
          "$ref": "#/$defs/vec2"
        },
        "max": {
          "$ref": "#/$defs/vec2"
        },
        "active_in": {
          "$ref": "#/$defs/active"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "min",
        "max",
        "material",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "box"
        },
        "min": {
          "$ref": "#/$defs/vec2"
        },
        "max": {
          "$ref": "#/$defs/vec2"
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "active_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path",
        "speed_mps",
        "radius_m",
        "active_in",
        "collision",
        "visual"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "patrol",
            "wander",
            "dwell",
            "seeded-wander"
          ]
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/vec2"
          }
        },
        "speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "active_in": {
          "$ref": "#/$defs/active"
        },
        "dormant_until_summoned": {
          "type": "boolean"
        },
        "collision": {
          "enum": [
            "fatal",
            "social"
          ]
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "ref_radius_m"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "ref_radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "waits": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
