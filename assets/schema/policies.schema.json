{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "policies.schema.json",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "policies"],
 "properties": {
 "schema_version": {"const": 1},
 "policies": {
 "type": "array", "minItems": 1,
 "items": {
 "type": "object", "additionalProperties": false,
 "required": ["id", "title", "description", "behavior"],
 "properties": {
 "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
 "title": {"type": "string", "minLength": 1},
 "description": {"type": "string", "minLength": 1},
 "behavior": {
 "type": "object", "additionalProperties": false,
 "required": ["cruise_mps", "safe_clearance_m", "lookahead_m"],
 "properties": {
 "cruise_mps": {"type": "number", "exclusiveMinimum": 0},
 "safe_clearance_m": {"type": "number", "minimum": 0},
 "lookahead_m": {"type": "number", "exclusiveMinimum": 0}
 }
 }
 }
 }
 }
}
}
