{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "model_profile",
    "coordinates",
    "drive",
    "collision",
    "mounts",
    "base_parts",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "basis",
        "source_refs"
      ],
      "properties": {
        "fidelity": {
          "enum": [
            "ideal",
            "typical",
            "identified"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "forward",
        "left",
        "up",
        "angles"
      ],
      "properties": {
        "units": {
          "const": "meters"
        },
        "forward": {
          "const": "+x"
        },
        "left": {
          "const": "+y"
        },
        "up": {
          "const": "+z"
        },
        "angles": {
          "const": "degrees"
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "wheel_radius_m",
        "wheel_base_m",
        "rated_speed_mps",
        "mass_kg",
        "yaw_inertia_kgm2",
        "motor",
        "steering",
        "energy",
        "encoder",
        "max_yaw_accel_radps2"
      ],
      "properties": {
        "type": {
          "enum": [
            "differential",
            "ackermann",
            "tracked",
            "swerve",
            "mecanum"
          ]
        },
        "label_key": {
          "type": "string",
          "minLength": 1
        },
        "wheel_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wheel_base_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rated_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effective_track_width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "track_width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "motor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_wheel_speed_mps",
            "max_wheel_accel_mps2",
            "stall_force_N",
            "free_speed_mps",
            "pwm_limit",
            "integral_limit",
            "wheel_equiv_mass_kg",
            "controller_bandwidth_radps",
            "controller_integral_time_s",
            "controller_derivative_time_s",
            "static_friction_feedforward_duty",
            "coulomb_smoothing_speed_mps",
            "viscous_drag_N_per_mps"
          ],
          "properties": {
            "max_wheel_speed_mps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_wheel_accel_mps2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stall_force_N": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "free_speed_mps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pwm_limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "integral_limit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wheel_equiv_mass_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "controller_bandwidth_radps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "controller_integral_time_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "controller_derivative_time_s": {
              "type": "number",
              "minimum": 0
            },
            "static_friction_feedforward_duty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "coulomb_smoothing_speed_mps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "viscous_drag_N_per_mps": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "encoder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counts_per_revolution"
          ],
          "properties": {
            "counts_per_revolution": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "service_brake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "maximum_torque_Nm",
            "apply_time_s",
            "release_time_s",
            "low_speed_smoothing_radps"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maximum_torque_Nm": {
              "type": "number",
              "minimum": 0
            },
            "apply_time_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "release_time_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "low_speed_smoothing_radps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_inertia_kgm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "track_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_yaw_rate_rads": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integral_limit"
          ],
          "properties": {
            "integral_limit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_steer_rad": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_steer_rate_radps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "servo_response_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stall_torque_Nm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "energy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_w",
            "per_v_w",
            "per_w_w"
          ],
          "properties": {
            "base_w": {
              "type": "number",
              "minimum": 0
            },
            "per_v_w": {
              "type": "number",
              "minimum": 0
            },
            "per_w_w": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "max_yaw_accel_radps2": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_radius_m",
        "rigid_body"
      ],
      "properties": {
        "planning_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rigid_body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "size_m"
          ],
          "properties": {
            "shape": {
              "const": "box"
            },
            "size_m": {
              "$ref": "#/$defs/positive_vec3"
            }
          }
        }
      }
    },
    "articulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_link",
        "links",
        "joints",
        "actuators"
      ],
      "properties": {
        "root_link": {
          "$ref": "#/$defs/id"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "position_m",
              "rotation_deg",
              "mass_kg",
              "inertia_diagonal_kgm2",
              "collision"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "position_m": {
                "$ref": "#/$defs/vec3"
              },
              "rotation_deg": {
                "$ref": "#/$defs/vec3"
              },
              "mass_kg": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "inertia_diagonal_kgm2": {
                "$ref": "#/$defs/positive_vec3"
              },
              "friction": {
                "type": "number",
                "minimum": 0
              },
              "spinning_resistance": {
                "type": "number",
                "minimum": 0
              },
              "contact_time_constant_s": {
                "type": "number",
                "minimum": 0.002
              },
              "contact_damping_ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "contact_axle_axis": {
                "$ref": "#/$defs/vec3"
              },
              "collision": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "shape"
                ],
                "properties": {
                  "shape": {
                    "enum": [
                      "box",
                      "cylinder",
                      "crowned_wheel",
                      "ellipsoid"
                    ]
                  },
                  "size_m": {
                    "$ref": "#/$defs/positive_vec3"
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "length_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "shape": {
                          "const": "box"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "size_m"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "shape": {
                          "enum": [
                            "cylinder",
                            "crowned_wheel",
                            "ellipsoid"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "radius_m",
                        "length_m"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "parent",
              "child",
              "pivot_in_parent_m",
              "pivot_in_child_m",
              "axis_in_parent",
              "axis_in_child"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "fixed",
                  "continuous",
                  "revolute"
                ]
              },
              "parent": {
                "$ref": "#/$defs/id"
              },
              "child": {
                "$ref": "#/$defs/id"
              },
              "pivot_in_parent_m": {
                "$ref": "#/$defs/vec3"
              },
              "pivot_in_child_m": {
                "$ref": "#/$defs/vec3"
              },
              "axis_in_parent": {
                "$ref": "#/$defs/vec3"
              },
              "axis_in_child": {
                "$ref": "#/$defs/vec3"
              },
              "lower_limit_rad": {
                "type": "number"
              },
              "upper_limit_rad": {
                "type": "number"
              },
              "damping_Nms_per_rad": {
                "type": "number",
                "minimum": 0
              },
              "friction_loss_Nm": {
                "type": "number",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "revolute"
                    }
                  }
                },
                "then": {
                  "required": [
                    "lower_limit_rad",
                    "upper_limit_rad"
                  ]
                }
              }
            ]
          }
        },
        "actuators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "joint",
              "effort_limit_Nm"
            ],
            "properties": {
              "channel": {
                "$ref": "#/$defs/id"
              },
              "joint": {
                "$ref": "#/$defs/id"
              },
              "effort_limit_Nm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "armature_inertia_kgm2": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "manipulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "channels",
        "shoulder_height_m",
        "upper_arm_length_m",
        "forearm_length_m",
        "tool_length_m",
        "lower_rad",
        "upper_rad",
        "home_rad",
        "kp",
        "kd",
        "maximum_effort_Nm",
        "maximum_velocity_radps",
        "gravity_moment_Nm",
        "end_effector_frame"
      ],
      "properties": {
        "type": {
          "const": "yaw_planar_3r"
        },
        "channels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "shoulder_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "upper_arm_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "forearm_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tool_length_m": {
          "type": "number",
          "minimum": 0
        },
        "lower_rad": {
          "$ref": "#/$defs/joint_array"
        },
        "upper_rad": {
          "$ref": "#/$defs/joint_array"
        },
        "home_rad": {
          "$ref": "#/$defs/joint_array"
        },
        "kp": {
          "$ref": "#/$defs/joint_array"
        },
        "kd": {
          "$ref": "#/$defs/joint_array"
        },
        "maximum_effort_Nm": {
          "$ref": "#/$defs/joint_array"
        },
        "maximum_velocity_radps": {
          "$ref": "#/$defs/joint_array"
        },
        "gravity_moment_Nm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "end_effector_frame": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position_m",
          "rotation_deg",
          "motion"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "position_m": {
            "$ref": "#/$defs/vec3",
            "description": "Mount origin expressed in the robot root base_link frame."
          },
          "rotation_deg": {
            "$ref": "#/$defs/vec3"
          },
          "frame_id": {
            "$ref": "#/$defs/id"
          },
          "motion": {
            "enum": [
              "fixed",
              "wheel",
              "track",
              "caster"
            ]
          },
          "rolling_radius_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "motion": {
                  "const": "wheel"
                }
              }
            },
            "then": {
              "required": [
                "rolling_radius_m"
              ]
            }
          }
        ]
      }
    },
    "passive_supports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steer_mount",
          "roll_mount"
        ],
        "properties": {
          "steer_mount": {
            "$ref": "#/$defs/id"
          },
          "roll_mount": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "base_parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mount",
          "visual"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "mount": {
            "$ref": "#/$defs/id"
          },
          "visual": {
            "$ref": "#/$defs/visual"
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "mounts"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "mounts": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "unlock_ability": {
      "type": "string",
      "pattern": "^ability\\.[a-z_]+$"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "positive_vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "joint_array": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_2d",
        "size_m",
        "color",
        "model_3d"
      ],
      "properties": {
        "primitive_2d": {
          "enum": [
            "box",
            "wheel",
            "disc"
          ]
        },
        "size_m": {
          "$ref": "#/$defs/vec3"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "model_3d": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+\\.glb$|^[a-zA-Z0-9_./-]+\\.gltf$"
        }
      }
    }
  }
}
