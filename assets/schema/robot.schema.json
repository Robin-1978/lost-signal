{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "robot.schema.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "id",
  "title",
  "coordinates",
  "drive",
  "collision",
  "mounts",
  "base_parts",
  "slots"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "id": {
   "$ref": "#/$defs/id"
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "coordinates": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "units",
    "forward",
    "left",
    "up",
    "angles"
   ],
   "properties": {
    "units": {
     "const": "meters"
    },
    "forward": {
     "const": "+x"
    },
    "left": {
     "const": "+y"
    },
    "up": {
     "const": "+z"
    },
    "angles": {
     "const": "degrees"
    }
   }
  },
  "drive": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "wheel_radius_m",
    "wheel_base_m",
    "mass_kg",
    "yaw_inertia_kgm2",
    "motor",
    "steering",
    "energy",
    "encoder",
    "max_yaw_accel_radps2"
   ],
   "properties": {
    "type": {
     "enum": [
      "differential",
      "ackermann"
     ]
    },
    "wheel_radius_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "wheel_base_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "motor": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "max_wheel_speed_mps",
      "max_wheel_accel_mps2",
      "stall_force_N",
      "free_speed_mps",
      "pwm_limit",
      "integral_limit",
      "wheel_equiv_mass_kg"
     ],
     "properties": {
      "max_wheel_speed_mps": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "max_wheel_accel_mps2": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "stall_force_N": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "free_speed_mps": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "pwm_limit": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1
      },
      "integral_limit": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "wheel_equiv_mass_kg": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     }
    },
    "encoder": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "counts_per_revolution"
     ],
     "properties": {
      "counts_per_revolution": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "mass_kg": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "yaw_inertia_kgm2": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "steering": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "integral_limit"
     ],
     "properties": {
      "integral_limit": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     }
    },
    "energy": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "base_w",
      "per_v_w",
      "per_w_w"
     ],
     "properties": {
      "base_w": {
       "type": "number",
       "minimum": 0
      },
      "per_v_w": {
       "type": "number",
       "minimum": 0
      },
      "per_w_w": {
       "type": "number",
       "minimum": 0
      }
     }
    },
    "max_yaw_accel_radps2": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "collision": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "shape",
    "radius_m",
    "height_m"
   ],
   "properties": {
    "shape": {
     "const": "cylinder"
    },
    "radius_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "height_m": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "mounts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "position_m",
     "rotation_deg"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "position_m": {
      "$ref": "#/$defs/vec3"
     },
     "rotation_deg": {
      "$ref": "#/$defs/vec3"
     }
    }
   }
  },
  "base_parts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "mount",
     "visual"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "mount": {
      "$ref": "#/$defs/id"
     },
     "visual": {
      "$ref": "#/$defs/visual"
     }
    }
   }
  },
  "slots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "slot",
     "mounts"
    ],
    "properties": {
     "slot": {
      "enum": [
       "tires",
       "sensor",
       "computer",
       "motor",
       "imu"
      ]
     },
     "mounts": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.-]+$"
  },
  "vec3": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "number"
   }
  },
  "visual": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "primitive_2d",
    "size_m",
    "color",
    "model_3d"
   ],
   "properties": {
    "primitive_2d": {
     "enum": [
      "box",
      "wheel",
      "disc"
     ]
    },
    "size_m": {
     "$ref": "#/$defs/vec3"
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "model_3d": {
     "type": "string",
     "pattern": "^[a-zA-Z0-9_./-]+\\.glb$"
    }
   }
  }
 }
}
