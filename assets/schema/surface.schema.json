{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "surface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "friction_mu",
          "rolling_drag",
          "traction_scale",
          "lidar_reflectivity"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "friction_mu": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rolling_drag": {
            "type": "number",
            "minimum": 0
          },
          "traction_scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "normal_stiffness_Npm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "normal_damping_Nspm": {
            "type": "number",
            "minimum": 0
          },
          "lidar_reflectivity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "texture": {
            "type": "string",
            "minLength": 1
          },
          "albedo_tint": {
            "$ref": "#/$defs/color"
          },
          "drive_effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "color",
              "intensity"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "none",
                  "dust",
                  "spray"
                ]
              },
              "color": {
                "$ref": "#/$defs/color"
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    }
  }
}
