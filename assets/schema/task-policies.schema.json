{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-policies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_policies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "algorithm",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task\\.[a-z][a-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "enum": [
              "route-cost",
              "minimax-risk",
              "value-density",
              "balanced-density"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
